						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newuser456\",\n  \"email\": \"newuser456@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"New User 456\",\n  \"roleId\": 1\n}",
