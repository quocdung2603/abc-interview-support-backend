{
	"info": {
		"_postman_id": "exam-numeric-ids-collection",
		"name": "Exam APIs with Numeric IDs",
		"description": "Collection for testing exam APIs with numeric IDs (fieldId, topicId, levelId)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Empty Exam with Numeric IDs",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"userId\": 1,\n  \"examType\": \"VIRTUAL\",\n  \"title\": \"Java Backend Developer Interview\",\n  \"position\": \"Senior Backend Developer\",\n  \"fieldId\": 1,\n  \"topicId\": 1,\n  \"levelId\": 2,\n  \"topics\": [1, 2, 3],\n  \"questionTypes\": [1, 2],\n  \"questionCount\": 20,\n  \"duration\": 60,\n  \"language\": \"vi\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/exams",
					"host": ["{{base_url}}"],
					"path": ["exams"]
				},
				"description": "Create an empty exam with numeric IDs for field, topic, and level. The system validates that these IDs exist in the database."
			},
			"response": []
		},
		{
			"name": "2. Create Exam with Random Questions (Numeric IDs)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-User-Id",
						"value": "1",
						"description": "User ID header"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Spring Boot Practice Exam\",\n  \"position\": \"Java Developer\",\n  \"duration\": 45,\n  \"language\": \"vi\",\n  \"fieldId\": 1,\n  \"topicIds\": [1, 2, 3],\n  \"levelId\": 2,\n  \"questionTypeId\": 1,\n  \"numberOfQuestions\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/exams/with-random-questions",
					"host": ["{{base_url}}"],
					"path": ["exams", "with-random-questions"]
				},
				"description": "Create an exam and automatically add random questions based on numeric ID criteria (fieldId, topicIds, levelId). This API now stores numeric IDs in the database to avoid Unicode encoding issues with Vietnamese characters."
			},
			"response": []
		},
		{
			"name": "3. Add Random Questions to Exam (Numeric IDs)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"examId\": 1,\n  \"fieldId\": 1,\n  \"topicIds\": [1, 2],\n  \"levelId\": 2,\n  \"questionTypeId\": 1,\n  \"numberOfQuestions\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/exams/questions/random",
					"host": ["{{base_url}}"],
					"path": ["exams", "questions", "random"]
				},
				"description": "Add random questions to an existing exam using numeric IDs for field, topics, level, and question type. Uses ID-based queries to avoid Unicode encoding issues."
			},
			"response": []
		},
		{
			"name": "4. Update Exam with Numeric IDs",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"userId\": 1,\n  \"examType\": \"RECRUITER\",\n  \"title\": \"Updated Java Interview\",\n  \"position\": \"Lead Developer\",\n  \"fieldId\": 2,\n  \"topicId\": 3,\n  \"levelId\": 3,\n  \"topics\": [1, 2, 3, 4],\n  \"questionTypes\": [1, 2],\n  \"questionCount\": 25,\n  \"duration\": 90,\n  \"language\": \"en\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/exams/{{exam_id}}",
					"host": ["{{base_url}}"],
					"path": ["exams", "{{exam_id}}"]
				},
				"description": "Update an existing exam with new numeric IDs. The system validates that the new IDs exist."
			},
			"response": []
		},
		{
			"name": "5. Search Questions by Numeric IDs",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/questions/search?fieldId=1&topicIds=1&topicIds=2&levelId=2&questionTypeId=1&limit=20",
					"host": ["{{base_url}}"],
					"path": ["questions", "search"],
					"query": [
						{
							"key": "fieldId",
							"value": "1",
							"description": "Field ID (numeric)"
						},
						{
							"key": "topicIds",
							"value": "1",
							"description": "Topic ID 1"
						},
						{
							"key": "topicIds",
							"value": "2",
							"description": "Topic ID 2"
						},
						{
							"key": "levelId",
							"value": "2",
							"description": "Level ID (numeric)"
						},
						{
							"key": "questionTypeId",
							"value": "1",
							"description": "Question Type ID (numeric)"
						},
						{
							"key": "limit",
							"value": "20",
							"description": "Maximum number of results"
						}
					]
				},
				"description": "Search questions using numeric IDs. This is encoding-independent and works correctly with Vietnamese characters."
			},
			"response": []
		},
		{
			"name": "6. Get Exam by ID (Verify Numeric IDs)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/exams/{{exam_id}}",
					"host": ["{{base_url}}"],
					"path": ["exams", "{{exam_id}}"]
				},
				"description": "Get exam details to verify that fieldId, topicId, and levelId are stored correctly."
			},
			"response": []
		},
