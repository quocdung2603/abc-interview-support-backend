{
	"info": {
		"_postman_id": "social-service-api-complete",
		"name": "Social Service API - Complete",
		"description": "Complete API collection for testing social-service endpoints (Posts, Comments, Voting)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Posts Management",
			"item": [
				{
					"name": "1.1 Create Post",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"title\": \"My First Post\",\n  \"content\": \"This is the content of my first post. It can be quite long!\",\n  \"lockTime\": null\n}"
						},
						"url": {"raw": "http://localhost:8090/posts", "protocol": "http", "host": ["localhost"], "port": "8090", "path": ["posts"]}
					}
				},
				{
					"name": "1.2 Get All Posts (Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {"raw": "http://localhost:8090/posts?page=0&size=20", "protocol": "http", "host": ["localhost"], "port": "8090", "path": ["posts"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
					}
				},
				{
					"name": "1.3 Get Post By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {"raw": "http://localhost:8090/posts/1", "protocol": "http", "host": ["localhost"], "port": "8090", "path": ["posts", "1"]}
					}
				},
				{
					"name": "1.4 Update Post",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"title\": \"Updated Post Title\",\n  \"content\": \"This is the updated content.\",\n  \"lockTime\": null\n}"
						},
						"url": {"raw": "http://localhost:8090/posts/1", "protocol": "http", "host": ["localhost"], "port": "8090", "path": ["posts", "1"]}
					}
				}
			]
		}
	]
}
