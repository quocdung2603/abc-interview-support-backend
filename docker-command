9. kiểm tra db đã có dữ liệu chưa
	# authdb
	docker exec -i interview-postgres psql -U postgres -d authdb -c "SELECT 'authdb.users' as table_name, COUNT(*) as count FROM users UNION ALL SELECT 'authdb.roles', COUNT(*) FROM roles;"

	# userdb
	docker exec -i interview-postgres psql -U postgres -d userdb -c "SELECT 'userdb.users' as table_name, COUNT(*) as count FROM users UNION ALL SELECT 'userdb.elo_history', COUNT(*) FROM elo_history;"

	# careerdb
	docker exec -i interview-postgres psql -U postgres -d careerdb -c "SELECT 'careerdb.career_preferences' as table_name, COUNT(*) as count FROM career_preferences;"

	# questiondb
	docker exec -i interview-postgres psql -U postgres -d questiondb -c "SELECT 'questiondb.fields' as table_name, COUNT(*) as count FROM fields UNION ALL SELECT 'questiondb.topics', COUNT(*) FROM topics UNION ALL SELECT 'questiondb.levels', COUNT(*) FROM levels UNION ALL SELECT 'questiondb.question_types', COUNT(*) FROM question_types UNION ALL SELECT 'questiondb.questions', COUNT(*) FROM questions UNION ALL SELECT 'questiondb.answers', COUNT(*) FROM answers;"

	# examdb
	docker exec -i interview-postgres psql -U postgres -d examdb -c "SELECT 'examdb.exams' as table_name, COUNT(*) as count FROM exams UNION ALL SELECT 'examdb.exam_questions', COUNT(*) FROM exam_questions UNION ALL SELECT 'examdb.exam_registrations', COUNT(*) FROM exam_registrations UNION ALL SELECT 'examdb.results', COUNT(*) FROM results UNION ALL SELECT 'examdb.user_answers', COUNT(*) FROM user_answers;"

	# newsdb
	docker exec -i interview-postgres psql -U postgres -d newsdb -c "SELECT 'newsdb.news' as table_name, COUNT(*) as count FROM news;"

	# socialdb
	docker exec -i interview-postgres psql -U postgres -d socialdb -c "SELECT 'socialdb.posts' as table_name, COUNT(*) as count FROM posts UNION ALL SELECT 'socialdb.comments', COUNT(*) FROM comments UNION ALL SELECT 'socialdb.comment_votes', COUNT(*) FROM comment_votes;"

